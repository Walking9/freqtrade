{
  "strategy": "RotationConsensus",
  "timeframe": "1h",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "db_url": "sqlite:///user_data/tradesv3.rotation-consensus-four.dryrun.sqlite",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "_ft_has_params": {
      "ohlcv_max_poll_interval_secs": 15
    },
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "fetchMarkets": {
          "types": [
            "linear"
          ]
        }
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "fetchMarkets": {
          "types": [
            "linear"
          ]
        }
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "bot_name": "rotation-consensus-four",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
